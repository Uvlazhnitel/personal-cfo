# Local development values only. Never use these values in production.
NODE_ENV=development
POSTGRES_DB=personal_cfo_dev
POSTGRES_USER=personal_cfo
POSTGRES_PASSWORD=local-development-only

DATABASE_URL=postgresql://personal_cfo:local-development-only@postgres:5432/personal_cfo_dev
APP_ORIGIN=http://127.0.0.1:8080
SESSION_COOKIE_SECURE=false

# Optional Stage 6 Telegram text input. Set all three or leave all three empty.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
TELEGRAM_OWNER_ID=

# Stage 7.1 manual Sharesight synchronization. Required only by `pnpm sharesight:sync`.
# Generate the receipt key with: openssl rand -base64 32
SHARESIGHT_CLIENT_ID=
SHARESIGHT_CLIENT_SECRET=
SHARESIGHT_PORTFOLIO_ID=
SHARESIGHT_OWNER_ID=
SHARESIGHT_INVESTMENT_ACCOUNT_ID=
SHARESIGHT_RAW_RECEIPT_KEY=
SHARESIGHT_API_BASE_URL=https://api.sharesight.com

# Stage 7.2B manual Portfolio Manager synchronization. Required only by
# `pnpm portfolio-manager:sync`. Generate the receipt key with:
# openssl rand -base64 32
PORTFOLIO_MANAGER_BASE_URL=https://portfolio-manager.example
PORTFOLIO_MANAGER_API_TOKEN=
PORTFOLIO_MANAGER_OWNER_ID=
PORTFOLIO_MANAGER_INVESTMENT_ACCOUNT_ID=
PORTFOLIO_MANAGER_RAW_RECEIPT_KEY=

# Stage 8 Enable Banking secure connection, diagnostic fetch, and durable sync.
# The RSA private key stays outside the repository and must have mode 0600.
# Generate the data key with: openssl rand -base64 32
ENABLE_BANKING_APPLICATION_ID=
ENABLE_BANKING_PRIVATE_KEY_PATH=/run/secrets/enable-banking-private-key.pem
ENABLE_BANKING_OWNER_ID=
ENABLE_BANKING_REDIRECT_URL=http://127.0.0.1:8080/api/v1/open-banking/enable-banking/callback
ENABLE_BANKING_DATA_KEY=
ENABLE_BANKING_API_BASE_URL=https://api.enablebanking.com
# Scheduling and canonical import are independent fail-closed switches.
ENABLE_BANKING_SYNC_ENABLED=false
ENABLE_BANKING_SYNC_CRON=15 3 * * *
ENABLE_BANKING_SYNC_TIME_ZONE=Europe/Riga
ENABLE_BANKING_CANONICAL_IMPORT_ENABLED=false
